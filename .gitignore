# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
*.log
npm-debug.log*
pnpm-debug.log*

# Rust / Tauri
# The build directory is at the workspace root now, not under src-tauri/.
# (src-tauri/ still has its own .gitignore for the schemas Tauri generates.)
/target/

# Python bytecode
# `tools/` is the prose linter, which is stdlib Python and runs from source.
# CPython writes these beside it on every run.
__pycache__/
*.pyc

# Generated file icons
# Built from the `material-icon-theme` dependency by
# `scripts/generate-file-icons.mjs`. Checking in 1115 SVGs and a 400 KB lookup
# table would be vendoring a package the manifest already declares.
/public/icons/material/
/packages/file-icons/src/manifest.generated.ts

# Generated branding
# Emitted from branding.toml by `scripts/generate-branding.mjs`, one module per
# frontend bundle that draws a brand string. Tracking them would put the
# product's name in four files instead of one, which is the thing branding.toml
# exists to prevent.
/src/branding.generated.ts
/apps/home/ui/src/branding.generated.ts
/apps/files/ui/src/branding.generated.ts
/apps/tutorial/ui/src/branding.generated.ts

# Worktrees an agent works in. A second checkout of this repository, inside it.
.claude/worktrees/

# `pnpm probe ... screenshot` writes here by default only if KAAVA_SHOT points
# into the repo (its own default is now the OS temp dir, precisely so this
# never happens on its own). Kept as a safety net: it is a picture of
# somebody's debugging session, and it has been swept into a commit by
# `git add -A` more than once already.
kaava-shot.png

# Terraform (infra/). Provider plugins are downloaded per checkout; state lives in the
# `<project>-tfstate` bucket, except bootstrap's before its first migration. tfvars files other
# than the committed common.tfvars can hold the billing account ID, and this repository is public.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/terraform/*/terraform.tfvars
# Packer's download cache (infra/images/).
packer_cache/
