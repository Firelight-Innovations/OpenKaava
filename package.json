{
  "name": "openkaava-orchestrator",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent",
    "build": "pnpm run build:bridge && pnpm run generate:icons && pnpm run generate:branding && pnpm run build:file-icons && pnpm run build:monaco-languages && pnpm run build:scene-view && tsc && vite build",
    "build:bridge": "pnpm --filter @openkaava/bridge build",
    "build:scene-view": "pnpm --filter @kaava/scene-view build",
    "build:file-icons": "pnpm --filter @openkaava/file-icons build",
    "build:monaco-languages": "pnpm --filter @openkaava/monaco-languages build",
    "generate:icons": "node scripts/generate-file-icons.mjs",
    "generate:branding": "node scripts/generate-branding.mjs",
    "postinstall": "pnpm run generate:icons && pnpm run generate:branding",
    "lint": "pnpm run lint:version && pnpm run lint:identity && pnpm run lint:branding && pnpm run lint:js && pnpm run lint:rust && pnpm run lint:comments",
    "lint:version": "node scripts/check-version.mjs",
    "lint:identity": "node scripts/check-identity.mjs",
    "lint:branding": "node scripts/check-branding.mjs",
    "lint:js": "eslint .",
    "lint:rust": "node scripts/clippy-baseline.mjs",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:deps": "cargo deny check",
    "bench:startup": "node scripts/bench-startup.mjs",
    "bench:load": "node scripts/bench-load.mjs",
    "bench:frame": "node scripts/bench-frame.mjs",
    "bench:drag": "node scripts/bench-drag.mjs",
    "bench:lint": "node scripts/bench-lint.mjs",
    "bench:search": "node scripts/bench-search.mjs",
    "slop": "node scripts/slop.mjs",
    "probe": "node scripts/kaava-probe.mjs",
    "ui": "node scripts/kaava-ui.mjs",
    "ui:build": "tauri build --no-bundle --config {\\\"identifier\\\":\\\"com.firelightinnovations.openkaava.agent\\\"}",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:js && pnpm run test:rust",
    "test:js": "vitest run && pnpm --filter \"./packages/**\" --filter \"./examples/**\" --if-present test",
    "test:rust": "cargo test --workspace",
    "typecheck": "pnpm run build:bridge && pnpm run generate:branding && pnpm run build:file-icons && pnpm run build:monaco-languages && pnpm run build:scene-view && tsc",
    "verify": "pnpm build && pnpm test && pnpm lint && pnpm format:check",
    "verify:fast": "pnpm run typecheck && pnpm test && pnpm lint && pnpm format:check",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "baseline": "eslint . --suppress-all && node scripts/clippy-baseline.mjs --update && node scripts/check-comments.mjs --update",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@kaava/markup": "workspace:*",
    "@kaava/scene-view": "workspace:*",
    "@openkaava/bridge": "workspace:*",
    "@openkaava/file-icons": "workspace:*",
    "@openkaava/monaco-languages": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.48.0",
    "markdown-it": "^15.0.2",
    "material-icon-theme": "^5.37.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.13",
      "jsdom": "^29.1.1"
    }
  }
}
