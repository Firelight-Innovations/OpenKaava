# Plane CE settings for OpenKaava (docs/design/OPENKAAVA-PLANE-DESIGN.md, section 6.2). The
# compose file beside this one is Plane's release file, unmodified; everything we configure is here.
#
# render_env.py turns this into plane.env on a tmpfs, never on disk:
#   ${SECRET:<name>}  Secret Manager secret plane-<name> (plane-dev-<name> for the local instance)
#   ${PARAM:<name>}   set by the caller: boot.sh on plane-vm, local/up.sh on the laptop
# Anything not listed keeps the default from Plane's release variables.env.

APP_RELEASE=v1.4.2
APP_DOMAIN=${PARAM:domain}
WEB_URL=${PARAM:web_url}
CORS_ALLOWED_ORIGINS=${PARAM:web_url}
DEBUG=0

# Plain HTTP on one port. Traffic is already inside an IAP tunnel or the private VPC, so there is
# no certificate and no load balancer. The compose file publishes an HTTPS port whatever we set;
# nothing listens behind it and no firewall rule reaches it.
LISTEN_HTTP_PORT=${PARAM:port}
LISTEN_HTTPS_PORT=${PARAM:https_port}
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=
# Unused on :80, but the proxy's Caddyfile fails to parse without a value. Plane's default.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

API_BASE_URL=http://api:8000
SECRET_KEY=${SECRET:secret-key}
LIVE_SERVER_SECRET_KEY=${SECRET:live-secret-key}

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=${SECRET:postgres-password}
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:${SECRET:postgres-password}@plane-db:5432/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=${SECRET:rabbitmq-password}
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:${SECRET:rabbitmq-password}@plane-mq:5672/plane

USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=plane
AWS_SECRET_ACCESS_KEY=${SECRET:minio-secret}
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880

# Plane's default is 60 per minute per key. plane-watch, OpenKaava and agent sessions each have
# their own key, but one agent session listing a large project can pass 60 alone.
API_KEY_RATE_LIMIT=300/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# Lets Plane deliver webhooks to plane-watch on its own Docker network, which its SSRF check
# would otherwise refuse as a private address (section 7.3).
WEBHOOK_ALLOWED_HOSTS=plane-watch
WEBHOOK_ALLOWED_IPS=
