{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKaava",
  "version": "../package.json",
  "identifier": "com.firelightinnovations.openkaava",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenKaava",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 632,
        "height": 432,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../kaava.toml": "kaava.toml"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Firelight-Innovations/OpenKaava/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMTYyQzdGRUIxMjJFNUYKUldSZkxoTHJmeXdXamdZWVNZaXRTVGtQekF6QmFNbHFVejM3SE9WSTE4L1NBSDhPa25EVERtd1UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
