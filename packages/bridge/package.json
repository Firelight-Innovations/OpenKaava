{
  "name": "@openkaava/bridge",
  "version": "0.1.0",
  "description": "Transport bridge between an OpenKaava tool's frontend and its host \u2014 the orchestrator shell over window messages, or a standalone Tauri app over Tauri IPC.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firelight-Innovations/OpenKaava.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/Firelight-Innovations/OpenKaava/blob/main/docs/tool-protocol.md",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10"
  }
}
