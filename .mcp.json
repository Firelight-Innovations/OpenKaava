{
  "mcpServers": {
    "veistra-canvas": {
      "headers": {
        "Authorization": "Bearer ${VEISTRA_MCP_TOKEN}"
      },
      "type": "http",
      "url": "http://127.0.0.1:${VEISTRA_MCP_PORT}/mcp/canvas"
    },
    "veistra-context": {
      "headers": {
        "Authorization": "Bearer ${VEISTRA_MCP_TOKEN}"
      },
      "type": "http",
      "url": "http://127.0.0.1:${VEISTRA_MCP_PORT}/mcp/context"
    },
    "veistra-workspace": {
      "headers": {
        "Authorization": "Bearer ${VEISTRA_MCP_TOKEN}"
      },
      "type": "http",
      "url": "http://127.0.0.1:${VEISTRA_MCP_PORT}/mcp/workspace"
    }
  }
}
