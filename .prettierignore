apps/tutorial/ui/src/branding.generated.ts

# Generated by tauri-build on every `cargo build`, and gitignored. Formatting
# them makes `format:check` fail on a clean tree the moment anyone builds.
src-tauri/gen/

# Vendored from the Veistra doc-control project, which owns them: the prose
# linter's config and its 66 wordlists, one of which is 88 KB of substitution
# data. Reformatting a copy is how a copy stops being diffable against the
# thing it was copied from, and the next re-sync becomes a merge instead of an
# overwrite. tools/*.py is outside Prettier's languages anyway.
tools/lint_config.json
tools/lint_data/

# Lockfiles are owned by their package managers.
pnpm-lock.yaml
Cargo.lock

# Per-machine Claude Code state, untracked and rewritten by the tool itself
# every time a permission is granted. Same failure mode as src-tauri/gen/
# above: it makes `format:check` fail on a clean tree for a file nobody in the
# repo owns or can keep formatted.
.claude/settings.local.json

# HTML is excluded, and this one is not a style preference. Whitespace between
# inline elements is significant in HTML, so reformatting it is not the
# guaranteed no-op it is in TypeScript or CSS. The concrete case: running
# Prettier over docs/handoffs/shell-spec.html rewrote 4540 lines of a
# standalone design artifact nobody edits by hand. The remaining HTML is Vite
# entry points, which are a few lines each and gain nothing from formatting.
*.html

# Markdown is deliberately excluded. The docs in this repo are hand-wrapped
# prose, and Prettier's markdown printer rewraps paragraphs — it would reflow
# every table and paragraph in STANDARDS.md and docs/tool-protocol.md for no
# gain. Prose wrapping stays a human decision.
*.md

# The Schematify reference fixtures: 5648 generated JSON files written by
# crates/schematify-core/fixtures/generate.mjs and regenerated whole. Prettier
# would reformat every one of them, and the diff of a regeneration would then
# depend on which tool ran last. The generator writes two-space JSON with a
# trailing newline, which is what Prettier would have produced anyway.
crates/schematify-core/fixtures/*/

# This repository's own Schematify project. Unlike the fixtures above, these
# files are written by the running application: `write_json_atomic` in
# crates/schematify-core/src/atomic.rs calls `serde_json::to_vec_pretty`, which
# expands every array onto its own lines. Prettier collapses a short array back
# onto one (`"params": ["a", "b"]`), so leaving this tree formatted would make
# `pnpm format:check` fail the moment anybody drags a node or edits a contract
# in the app. The formatter cannot own a tree another writer also owns.
.kaava/

# A git worktree an agent is working in: a second checkout of this repository
# sitting inside it. Formatting someone else's branch from this one is not this
# checkout's business.
.claude/worktrees/

# Plane CE's release compose file, committed byte-for-byte as the release published it (Plane
# design, section 6.1). Its sha256 is in the commit that added it; reformatting would break that.
infra/plane/compose/

# Generated Cloud Monitoring answers for the Cost Tracker: a month of hourly points, written compact
# by the fixture script. Prettier would put every point on six lines of its own.
src-tauri/fixtures/cloud/monitoring/
